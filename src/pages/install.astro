---
import Layout from "../layouts/Layout.astro";
import { repo, releases, vitrina, url } from "../lib/site";

const brew = `brew install adriandeleon/tap/jkit`;

const aptSetup = `sudo install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://vitrina-project.dev/vitrina.asc | sudo tee /etc/apt/keyrings/vitrina.asc > /dev/null
sudo tee /etc/apt/sources.list.d/vitrina.sources > /dev/null <<'EOF'
Types: deb
URIs: https://vitrina-project.dev/apt
Suites: stable
Components: main
Architectures: amd64 arm64
Signed-By: /etc/apt/keyrings/vitrina.asc
EOF
sudo apt update
sudo apt install jkit`;

const packages = `sudo apt install ./jkit_*_amd64.deb      # Debian, Ubuntu (arm64: jkit_*_arm64.deb)
sudo dnf install ./jkit-*.x86_64.rpm     # Fedora, RHEL, Rocky, Alma (arm64: jkit-*.aarch64.rpm)`;

const verify = `sha256sum --check --ignore-missing SHA256SUMS
gh attestation verify jkit_*_amd64.deb --repo adriandeleon/jkit   # where and how it was built`;

const tarball = `tar -xzf jkit-*.tar.gz
sudo install jkit /usr/local/bin/`;

const winget = `winget install AdrianDeLeon.jkit`;

const pwshHook = `notepad $PROFILE
# add this line, save, and open a new PowerShell window:
jkit hook pwsh | Out-String | Invoke-Expression`;

const hook = `jkit hook --install                  # for your login shell: bash, zsh or fish
jkit hook --install --auto-switch    # and switch to a project's versions on cd`;

const source = `git clone ${repo}.git
cd jkit
./mvnw verify                                   # build and test on the JVM
GRAALVM_HOME=/path/to/graalvm-25 ./mvnw -Pnative package -DskipTests
sudo install jkit-cli/target/jkit /usr/local/bin/`;

const firstSteps = `jkit install jdk@21          # the first JDK you install becomes the default
java -version
jkit search jdk              # every vendor and release
jkit doctor                  # checks the setup and says how to fix what it finds`;

const uninstall = `jkit hook --uninstall        # takes jkit's block out of your shell's startup file
rm -rf ~/.jkit               # every install, link and setting
brew uninstall jkit          # or: sudo apt remove jkit, sudo dnf remove jkit, winget uninstall AdrianDeLeon.jkit`;
---

<Layout title="Install jkit" description="Install jkit with Homebrew, apt, a .deb or .rpm, winget, or a plain binary, then turn on the shell hook.">
  <div class="prose">
    <h1>Install jkit</h1>
    <p>
      jkit is a single native binary for x64 and arm64, and needs no JDK to run. On Linux it needs
      glibc 2.34 or newer and zlib: Debian 12+, Ubuntu 22.04+, Fedora, and RHEL, Rocky or Alma 9+
      (not Ubuntu 20.04, RHEL 8 or Alpine). On macOS it needs macOS 15 (Sequoia) or newer.
    </p>

    <h2 id="homebrew">macOS and Linux: Homebrew</h2>
    <pre><code>{brew}</code></pre>
    <p>
      <code>brew upgrade</code> keeps it current. The macOS binaries are signed and notarized by
      Apple, so Gatekeeper lets them run.
    </p>

    <h2 id="apt">Debian and Ubuntu: apt</h2>
    <p>
      jkit is published in the <a href={vitrina}>Vitrina</a> apt repository, so
      <code>apt upgrade</code> keeps it current. Add the repository once, then install:
    </p>
    <pre><code>{aptSetup}</code></pre>

    <h2 id="packages">.deb or .rpm download</h2>
    <p>Download the package for your system from the <a href={releases}>latest release</a>, then:</p>
    <pre><code>{packages}</code></pre>
    <p>
      To check a download, get <code>SHA256SUMS</code> from the same release. Every file also has
      a build provenance attestation, which the <a href="https://cli.github.com">GitHub CLI</a>
      can verify:
    </p>
    <pre><code>{verify}</code></pre>

    <h2 id="windows">Windows (preview)</h2>
    <pre><code>{winget}</code></pre>
    <p>
      Or download <code>jkit-*-windows-x64.zip</code> from the <a href={releases}>latest
      release</a> and put <code>jkit.exe</code> on your <code>PATH</code>. It needs the Microsoft
      Visual C++ Redistributable (2015 or newer, x64): winget installs it along with jkit, and
      most machines already have it. Windows on ARM runs the x64 build under emulation.
    </p>
    <p>
      Windows works, but is less tested than macOS and Linux. <code>jkit hook --install</code>
      doesn't edit PowerShell profiles yet, so add the hook by hand:
    </p>
    <pre><code>{pwshHook}</code></pre>
    <p>
      Switching on <code>cd</code> isn't available in PowerShell yet. Programs started outside a
      hooked PowerShell (cmd.exe, IDEs) see <code>jkit use … --global</code> only if you set
      <code>JAVA_HOME</code> to <code>%USERPROFILE%\.jkit\global\jdk</code> once and add
      <code>%JAVA_HOME%\bin</code> to your user <code>PATH</code>.
    </p>

    <h2 id="tarball">Any other system: a plain binary</h2>
    <p>
      Download the <code>.tar.gz</code> for your platform (<code>linux-x64</code>,
      <code>linux-aarch64</code>, <code>macos-aarch64</code> for Apple Silicon or
      <code>macos-x64</code> for Intel) from the <a href={releases}>latest release</a>:
    </p>
    <pre><code>{tarball}</code></pre>

    <h2 id="hook">Turn on the shell hook</h2>
    <p>
      A program can't change the shell that started it, so <code>jkit use</code> needs a small
      shell function. <code>jkit hook --install</code> adds a short, marked block that loads it to
      <code>~/.bashrc</code>, <code>~/.zshrc</code> or fish's <code>conf.d</code>, and prints
      exactly what it added:
    </p>
    <pre><code>{hook}</code></pre>
    <p>
      The hook puts the global versions on <code>PATH</code> and sets <code>JAVA_HOME</code>,
      <code>MAVEN_HOME</code>, <code>GRADLE_HOME</code>, <code>SBT_HOME</code> and
      <code>GRAALVM_HOME</code> when you haven't set them yourself. Tab completion comes with it
      in bash and zsh. To load it by hand instead, add <code>eval "$(jkit hook bash)"</code>
      (or <code>zsh</code>) to your startup file, or <code>jkit hook fish | source</code> in fish.
    </p>

    <h2 id="first-steps">First steps</h2>
    <p>Open a new shell, then:</p>
    <pre><code>{firstSteps}</code></pre>
    <p>Then see the <a href={url("docs")}>docs</a>.</p>

    <h2 id="from-source">From source</h2>
    <p>Building needs JDK 25 and, for the native binary, GraalVM 25.</p>
    <pre><code>{source}</code></pre>

    <h2 id="uninstall">Uninstall</h2>
    <pre><code>{uninstall}</code></pre>
  </div>
</Layout>
